<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="container">
  <%- include('../partials/flash') %>
  <div class="page-title">
    <div>
      <p class="eyebrow">Admin</p>
      <h1>Data Siswa</h1>
    </div>
  </div>
  <section class="split">
    <form class="panel form stack" method="post" action="<%= edit ? '/admin/siswa/' + edit.nis : '/admin/siswa' %>">
      <h2><%= edit ? 'Edit Siswa' : 'Tambah Siswa' %></h2>
      <label>NIS
        <input name="nis" value="<%= edit ? edit.nis : '' %>" <%= edit ? 'readonly' : 'required' %>>
      </label>
      <label>Username
        <input name="username" value="<%= edit ? edit.username : '' %>" placeholder="username-login-siswa" oninput="this.value = this.value.replace(/\s+/g, '-')" required>
      </label>
      <label>Nama Siswa
        <input name="nama_siswa" value="<%= edit ? edit.nama_siswa : '' %>" required>
      </label>
      <label>Kelas
        <input name="kelas" value="<%= edit ? edit.kelas : '' %>" placeholder="X-A" required>
      </label>
      <label>Password <small><%= edit ? 'kosongkan jika tidak diubah' : 'default username jika kosong' %></small>
        <input type="password" name="password">
      </label>
      <div class="actions">
        <button class="primary" type="submit">Simpan</button>
        <% if (edit) { %><a class="button" href="/admin/siswa">Batal</a><% } %>
      </div>
    </form>
    <section class="panel">
      <h2>Daftar Siswa</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>NIS</th><th>Username</th><th>Nama</th><th>Kelas</th><th>Aksi</th></tr></thead>
          <tbody>
            <% siswa.forEach((item) => { %>
              <tr>
                <td><%= item.nis %></td>
                <td><%= item.username %></td>
                <td><%= item.nama_siswa %></td>
                <td><%= item.kelas %></td>
                <td class="row-actions">
                  <a href="/admin/siswa/<%= item.nis %>/edit">Edit</a>
                  <form method="post" action="/admin/siswa/<%= item.nis %>/delete" onsubmit="return confirm('Hapus siswa ini?')">
                    <button type="submit" class="danger-link">Hapus</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
  </section>
</main>
<%- include('../partials/footer') %>
