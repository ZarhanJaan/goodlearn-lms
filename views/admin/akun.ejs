<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="container">
  <%- include('../partials/flash') %>
  <div class="page-title">
    <div>
      <p class="eyebrow">Admin</p>
      <h1>Kelola Admin</h1>
    </div>
  </div>
  <section class="split">
    <form class="panel form stack" method="post" action="<%= edit ? '/admin/akun/' + edit.id_admin : '/admin/akun' %>">
      <h2><%= edit ? 'Edit Admin' : 'Tambah Admin' %></h2>
      <label>Username
        <input name="username" value="<%= edit ? edit.username : '' %>" placeholder="username-admin" oninput="this.value = this.value.replace(/\s+/g, '-')" required>
      </label>
      <label>Nama Lengkap
        <input name="nama_lengkap" value="<%= edit ? edit.nama_lengkap : '' %>" required>
      </label>
      <label>Password <small><%= edit ? 'kosongkan jika tidak diubah' : 'default username jika kosong' %></small>
        <input type="password" name="password">
      </label>
      <div class="actions">
        <button class="primary" type="submit">Simpan</button>
        <% if (edit) { %><a class="button" href="/admin/akun">Batal</a><% } %>
      </div>
    </form>
    <section class="panel">
      <h2>Daftar Admin</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>ID</th><th>Username</th><th>Nama Lengkap</th><th>Aksi</th></tr></thead>
          <tbody>
            <% admins.forEach((item) => { %>
              <tr>
                <td><%= item.id_admin %></td>
                <td><%= item.username %></td>
                <td><%= item.nama_lengkap %></td>
                <td class="row-actions">
                  <a href="/admin/akun/<%= item.id_admin %>/edit">Edit</a>
                  <form method="post" action="/admin/akun/<%= item.id_admin %>/delete" onsubmit="return confirm('Hapus admin ini?')">
                    <button type="submit" class="danger-link">Hapus</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
  </section>
</main>
<%- include('../partials/footer') %>
